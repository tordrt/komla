# Apple Notarization (required for macOS releases)
# Create an app-specific password at https://appleid.apple.com/account/manage
APPLE_ID=your-apple-id@email.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# Windows code signing with jsign (optional — unsigned when WIN_SIGN_STORETYPE is unset).
# See docs/RELEASING.md for what each store type expects.
# WIN_SIGN_STORETYPE=ESIGNER
# WIN_SIGN_KEYSTORE=
# WIN_SIGN_STOREPASS=
# WIN_SIGN_KEYPASS=
# WIN_SIGN_ALIAS=
# WIN_SIGN_CERTFILE=
# WIN_SIGN_TSA_URL=http://timestamp.digicert.com,http://timestamp.sectigo.com
# JSIGN=jsign

# Token for the Komla-managed AI helpers (utility.komla.dev). Required for
# releases; dev builds read it too, so managed workspace naming works locally.
KOMLA_UTILITY_TOKEN=

# Cloudflare R2 (optional — overrides default bucket name)
# KOMLA_R2_BUCKET=komla-releases
