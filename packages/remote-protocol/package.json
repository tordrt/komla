{
  "name": "@komla/remote-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated encrypted channel protocol between a Komla desktop and a trusted remote browser. Pure WebCrypto, no DOM, no Node-only APIs.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
