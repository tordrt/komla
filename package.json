{
  "name": "komla",
  "version": "1.0.0-staging.3",
  "description": "Run multiple AI coding agent CLIs in parallel",
  "author": "Tafjord Invest AS",
  "license": "AGPL-3.0-only",
  "private": true,
  "homepage": "https://komla.dev",
  "repository": "github:tordrt/komla",
  "bugs": "https://github.com/tordrt/komla/issues",
  "type": "module",
  "main": "./out/main/index.js",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "packages/*",
    "remote-web"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh default",
    "dev:fresh": "bash scripts/dev.sh sandbox-fresh",
    "dev:sandbox": "bash scripts/dev.sh sandbox",
    "dev:sandbox:clean": "bash scripts/dev.sh sandbox-clean",
    "preview": "bash scripts/link-deps.sh && node scripts/ensure-native-modules.cjs && env -u NODE_ENV KOMLA_DIAGNOSTICS=1 electron-vite preview",
    "build": "bash scripts/link-deps.sh && npm --workspace komla-remote-web run build:web && electron-vite build",
    "build:native": "bash scripts/build-native.sh",
    "build:native:matrix": "bash scripts/build-native-matrix.sh",
    "typecheck": "bash scripts/typecheck.sh",
    "lint": "bash scripts/link-deps.sh && oxlint src --type-aware && eslint src --ext .ts,.tsx",
    "lint:fix": "bash scripts/link-deps.sh && oxlint src --type-aware --fix && eslint src --ext .ts,.tsx --fix",
    "format": "bash scripts/link-deps.sh && oxfmt \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "bash scripts/link-deps.sh && oxfmt --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "bash scripts/test.sh",
    "test:watch": "bash scripts/link-deps.sh && vitest",
    "test:coverage": "bash scripts/link-deps.sh && vitest run --coverage",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "test:integration": "bash scripts/link-deps.sh && vitest run --config vitest.integration.config.ts tests/integration/ssh-workspace/container-ssh-workspace.test.ts",
    "test:e2e": "npm run build && npx playwright test --config e2e/playwright.config.ts e2e/*.test.ts",
    "test:e2e:no-build": "npx playwright test --config e2e/playwright.config.ts e2e/*.test.ts",
    "smoke-test": "bash scripts/smoke-test.sh",
    "release": "bash scripts/release.sh",
    "postinstall": "install-electron && node scripts/worktree-deps.cjs postinstall && node scripts/install-git-hooks.cjs",
    "deps:gc": "node scripts/worktree-deps.cjs gc",
    "screenshots": "npx playwright test --config e2e/playwright.config.ts e2e/screenshots/",
    "screenshots:process": "node scripts/process-screenshots.mjs",
    "screenshots:landing": "npx playwright test --config e2e/playwright.config.ts e2e/screenshots/landing-page.screenshot.ts e2e/screenshots/dialogs.screenshot.ts && node scripts/process-screenshots.mjs --landing-only",
    "videos": "npm run build && npx playwright test --config e2e/playwright.config.ts e2e/videos/ && node scripts/render-videos.mjs",
    "demo": "npx playwright test --config e2e/playwright.config.ts --headed e2e/demos/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@parcel/watcher": "^2.5.6",
    "@simplewebauthn/server": "^14.0.3",
    "@vscode/ripgrep": "^1.17.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "electron-updater": "^6.8.10",
    "ignore": "^7.0.5",
    "js-yaml": "^4.3.2",
    "keyboard-layout": "^2.0.17",
    "node-pty": "^1.1.0",
    "sherpa-onnx-node": "1.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@komla/remote-protocol": "*",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@monaco-editor/react": "^4.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/trees": "1.0.0-beta.6",
    "@playwright/test": "^1.58.1",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@shikijs/monaco": "^4.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dompurify": "3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jsdom": "^29.0.1",
    "marked": "14.0.0",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^7.0.2003",
    "png2icons": "^2.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-window": "^2.2.7",
    "sharp": "^0.35.5",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4"
  }
}
