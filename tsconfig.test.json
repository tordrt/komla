{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./out/tests",
    "lib": ["ESNext"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": ["tests/**/*", "src/shared/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
